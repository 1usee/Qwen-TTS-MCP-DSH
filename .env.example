# Qwen Voice MCP — 环境变量示例
# 复制为 .env 并按需修改；.env 不应提交到版本库。
# 优先级：CLI 参数 > 环境变量 > %APPDATA%\qwen-voice-mcp\config.json > 默认值

# ── 必填 ─────────────────────────────────────────────────────────
# Qwen（DashScope）API 密钥。留空则回退到加密 vault（推荐用 GUI 或 CLI 写入）。
DASHSCOPE_API_KEY=

# ── 存储位置 ─────────────────────────────────────────────────────
# 配置、密钥库与输出的根目录
QWEN_VOICE_HOME=

# ── 服务 ─────────────────────────────────────────────────────────
# stdio | streamable-http | sse
QWEN_VOICE_TRANSPORT=stdio
# HTTP 监听地址；非环回地址需显式开启放行
QWEN_VOICE_HOST=127.0.0.1
QWEN_VOICE_PORT=8765
# HTTP 模式的 Bearer Token（务必设置）
QWEN_VOICE_HTTP_AUTH_TOKEN=

# ── 语音 ─────────────────────────────────────────────────────────
QWEN_VOICE_DEFAULT_MODEL=cosyvoice-v2
QWEN_VOICE_DEFAULT_VOICE=longanyang
QWEN_VOICE_DEFAULT_OUTPUT_FORMAT=mp3

# ── 余额策略 ─────────────────────────────────────────────────────
# 低于该值即拒绝执行计费调用
QWEN_VOICE_BALANCE_THRESHOLD=1.00
# true = 余额查询失败时也拒绝执行；false = 放行但附警告
QWEN_VOICE_STRICT_BALANCE=false
QWEN_VOICE_BALANCE_TIMEOUT_SECONDS=8.0

# ── 音频校验 ─────────────────────────────────────────────────────
QWEN_VOICE_AUDIO_MIN_SECONDS=5.0
QWEN_VOICE_AUDIO_MAX_SECONDS=60.0
QWEN_VOICE_AUDIO_MAX_BYTES=20971520

# ── 日志 ─────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
QWEN_VOICE_LOG_LEVEL=INFO
